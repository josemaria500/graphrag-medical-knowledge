services:
  api:
    build:
      context: .
      dockerfile: backend/Dockerfile
    container_name: graphrag_api
    env_file:
      - .env
    dns:
      - 8.8.8.8
      - 1.1.1.1
      - 8.8.4.4
    networks:
      - graphrag_net
    restart: unless-stoppedservices:
  api:
    build:
      context: .
      dockerfile: backend/Dockerfile
    container_name: graphrag_api
    env_file:
      - .env
    networks:
      - graphrag_net
    restart: unless-stopped

  web:
    build:
      context: .
      dockerfile: frontend/Dockerfile
    container_name: graphrag_web
    environment:
      - API_URL=http://api:8000/query
      - STREAMLIT_SERVER_BASE_URL_PATH=graphrag
    depends_on:
      - api
    networks:
      - graphrag_net
    restart: unless-stopped

  nginx:
    image: nginx:alpine
    container_name: graphrag_nginx
    ports:
      - "80:80"
    volumes:
      - ./nginx:/etc/nginx:ro
      - ./nginx/home:/usr/share/nginx/html:ro
    depends_on:
      - api
      - web
    networks:
      - graphrag_net
    restart: unless-stopped

networks:
  graphrag_net:
    driver: bridge
